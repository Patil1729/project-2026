VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_ALLOWED_HOSTS=dispose-mumbling-revocable.ngrok-free.dev

# Paths are relative to VITE_API_BASE_URL. Match these to AuthenticationController.
VITE_AUTH_LOGIN_PATH=/auth/signin
VITE_AUTH_SIGNUP_PATH=/auth/signup
VITE_AUTH_USER_PATH=/auth/user
VITE_AUTH_CSRF_PATH=/auth/csrf
VITE_AUTH_LOGOUT_PATH=/auth/signout
VITE_AUTH_CHANGE_PASSWORD_PATH=/auth/change-password
# Request field is username by default; set email if your SignInRequest uses email.
VITE_AUTH_USERNAME_FIELD=username

# Replace platform homepages with your own organisation profile URLs.
VITE_SOCIAL_FACEBOOK=https://www.facebook.com/
VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/
VITE_SOCIAL_YOUTUBE=https://www.youtube.com/
VITE_SOCIAL_X=https://x.com/

# Set approved real contact details. Leave empty until confirmed.
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
